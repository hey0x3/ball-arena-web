{
  "name": "ball-arena-web",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hey0x3/ball-arena-web.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run validate:content && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/content.ts",
    "schema": "tsx scripts/content.ts --write",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pixi.js": "8.22.0",
    "planck": "1.5.1",
    "zod": "4.6.7",
    "fflate": "0.8.3",
    "lucide-react": "1.65.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "tsx": "4.23.15",
    "@playwright/test": "1.64.1"
  }
}
